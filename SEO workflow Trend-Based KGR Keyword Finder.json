    {
      "parameters": {
        "jsCode": "// === FINAL PARSE — WORKS WITH OR WITHOUT ```json\nreturn $input.all().map(item => {\n  let text = item.json.text || '';\n\n  // Remove ```json and ``` if present\n  text = text.replace(/^```json\\s*/, '').replace(/\\s*```$/g, '').trim();\n\n  let data = {};\n  try {\n    data = JSON.parse(text);\n  } catch (e) {\n    // Fallback: try to extract JSON with regex\n    const jsonMatch = text.match(/\\{[\\s\\S]*\\}/);\n    if (jsonMatch) {\n      try {\n        data = JSON.parse(jsonMatch[0]);\n      } catch (e2) {\n        data = { error: \"Parse failed\", raw: text.substring(0, 200) };\n      }\n    } else {\n      data = { error: \"No JSON found\", raw: text.substring(0, 200) };\n    }\n  }\n\n  return {\n    json: {\n      keyword: data.keyword || \"unknown\",\n      title: data.title || \"\",\n      metaDescription: data.metaDescription || \"\",\n      outline: Array.isArray(data.outline) ? data.outline : [],\n      searchIntent: data.searchIntent || \"Informational\",\n      search_volume: data.search_volume || 0,\n      kgr: data.kgr || 0\n    }\n  };\n});"
      },
