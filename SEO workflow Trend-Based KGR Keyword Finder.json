    {
      "parameters": {
        "jsCode": "// === ALL-IN-ONE: EXTRACT + CLEAN DUPLICATES ===\n\nconst inputItem = $input.all()[0];\nlet data = inputItem.json?.body || inputItem.json;  // Handles body wrapper\n\nconst top = data?.related_queries?.top || [];\nconst rising = data?.related_queries?.rising || [];\n\nconst seen = new Set();\nconst results = [];\n\nconst toNum = (v) => (v === \"Breakout\" ? 100000 : parseInt(v) || 0);\n\n// TOP\ntop.forEach((q, i) => {\n  if (q?.query) {\n    const kw = String(q.query).trim().toLowerCase();\n    if (!seen.has(kw)) {\n      seen.add(kw);\n      results.push({\n        json: {\n          keyword: String(q.query).trim(),\n          value: toNum(q.value),\n          extracted_value: toNum(q.extracted_value),\n          type: \"top\",\n          rank: i + 1\n        }\n      });\n    }\n  }\n});\n\n// RISING (high growth only)\nrising.forEach((q, i) => {\n  if (q?.query) {\n    const val = toNum(q.value);\n    const kw = String(q.query).trim().toLowerCase();\n    if (val >= 1000 && !seen.has(kw)) {\n      seen.add(kw);\n      results.push({\n        json: {\n          keyword: String(q.query).trim(),\n          value: val,\n          extracted_value: toNum(q.extracted_value),\n          type: \"rising\",\n          rank: i + 1\n        }\n      });\n    }\n  }\n});\n\nreturn results.length > 0 ? results : [{ json: { keyword: \"exotic fruits (fallback)\", value: 50, type: \"fallback\" } }];"
      },
